-- [1] current_event (administrador, Kafka real)
SELECT event_id, coalesce(country_id, '(NULL)') AS country_id, coalesce(mag::text, '(NULL)') AS mag, is_synthetic FROM live.current_event WHERE event_id LIKE 'synthetic-geo-%' ORDER BY event_id;
        event_id         | country_id |  mag   | is_synthetic 
-------------------------+------------+--------+--------------
 synthetic-geo-atlantico | (NULL)     | 3.0    | t
 synthetic-geo-madrid    | ESP        | 3.0    | t
 synthetic-geo-mag-nula  | ESP        | (NULL) | t
(3 rows)

-- [2] Recuentos: total = con país + sin país
SELECT count(*) AS total, count(country_id) AS con_pais, count(*) - count(country_id) AS sin_pais FROM live.current_event;
 total | con_pais | sin_pais 
-------+----------+----------
     3 |        2 |        1
(1 row)

-- [3] quarantine (administrador, Kafka real)
SELECT event_id, reason, kafka_topic, kafka_partition, kafka_offset FROM live.quarantine WHERE event_id LIKE 'synthetic-geo-%' ORDER BY kafka_offset;
       event_id        |          reason          |   kafka_topic    | kafka_partition | kafka_offset 
-----------------------+--------------------------+------------------+-----------------+--------------
 synthetic-geo-lat-145 | coordinates_out_of_range | earthquakes.live |               0 |            3
(1 row)

