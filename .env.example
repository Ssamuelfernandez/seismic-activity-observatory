# Copia este archivo a `.env` y ajusta los valores. `.env` está ignorado por Git.
# Los valores de abajo son EJEMPLOS no sensibles: cámbialos en tu equipo, no los subas.
# La correspondencia con el código está en specs/002-infra-compose/contracts/config.md.
# Comprobación automática: python scripts/check_env_example.py

# --- PostgreSQL (administrador: solo crea el esquema y los roles al inicializar) ---
POSTGRES_USER=observatory_admin
POSTGRES_PASSWORD=cambia-esta-clave-admin
POSTGRES_DB=observatory

# --- Contraseñas de los roles de cada servicio (mínimo privilegio) ---
DB_API_PASSWORD=cambia-esta-clave-api
DB_PRODUCER_PASSWORD=cambia-esta-clave-productor
DB_CONSUMER_PASSWORD=cambia-esta-clave-consumidor

# --- Conexiones entre contenedores: nombres de servicio, nunca localhost ---
DB_HOST=postgres
DB_PORT=5432
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Productor y consumidor mínimos ---
KAFKA_TOPIC=earthquakes.live
KAFKA_GROUP_ID=consumer-live
# Segundos entre eventos sintéticos (entre 1 y 60).
PRODUCER_INTERVAL_SECONDS=30

# --- Gancho de fallo del consumidor ---
# Offset tras el cual el consumidor se cae una vez, solo para la prueba 8. Vacío = desactivado.
CONSUMER_FAULT_CRASH_AT_OFFSET=

# --- Reintentos de conexión (espera exponencial entre intentos) ---
RETRY_INITIAL_SECONDS=1
RETRY_MAX_SECONDS=30

# --- Registro ---
LOG_LEVEL=INFO
